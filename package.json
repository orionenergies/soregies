{
  "name": "orion-bot-soregies",
  "version": "1.0.0",
  "description": "Orion automation bot for Soregies (Mon Espace Producteur) using Playwright and Express",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "playwright test --project=bot-chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "codegen": "playwright codegen",
    "test:e2e-mock": "playwright test --config=playwright.e2e-mock.config.ts"
  },
  "keywords": [
    "automation",
    "playwright",
    "typescript",
    "soregies",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "1.57.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "playwright": "1.57.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
